+_DFLASH_MAX_SPEC_SEQ_LEN_ENV = "VLLM_DFLASH_MAX_SPEC_SEQ_LEN"
+
+
+def _dflash_max_spec_seq_len_from_env() -> int | None:
+    """Parse the opt-in VLLM_DFLASH_MAX_SPEC_SEQ_LEN cutoff.
+
+    Returns None when the env var is unset or empty (default behavior is
+    preserved exactly). When set, validated as a positive integer.
+    """
+    raw = os.environ.get(_DFLASH_MAX_SPEC_SEQ_LEN_ENV)
+    if not raw:
+        return None
+    try:
+        cutoff = int(raw)
+    except ValueError as exc:
+        raise ValueError(
+            f"{_DFLASH_MAX_SPEC_SEQ_LEN_ENV} must be a positive integer, "
+            f"got {raw!r}"
+        ) from exc
+    if cutoff <= 0:
+        raise ValueError(
+            f"{_DFLASH_MAX_SPEC_SEQ_LEN_ENV} must be a positive integer, "
+            f"got {raw!r}"
+        )
+    return cutoff
+
+
+def _dflash_cutoff_hit(
+    max_spec_seq_len: int | None,
+    seq_lens_cpu_upper_bound: torch.Tensor,
+    num_reqs: int,
+) -> bool:
+    """True when the batch's longest live sequence reaches the cutoff.
+
+    K is batch-wide: the longest active request controls the whole step, so a
+    single request at the cutoff disables drafting for every request in the
+    batch. seq_lens_cpu_upper_bound is a CPU tensor, so this never syncs the
+    GPU.
+    """
+    return (
+        max_spec_seq_len is not None
+        and seq_lens_cpu_upper_bound[:num_reqs].max().item() >= max_spec_seq_len
+    )
+
+
+def _dflash_nvtx_enabled() -> bool:
+    return os.environ.get("VLLM_DFLASH_NVTX", "0") == "1"
+
+
+class _dflash_nvtx_range:
+    """Env-gated NVTX + torch-profiler range; no-op unless VLLM_DFLASH_NVTX=1."""
+
+    def __init__(self, name: str):
+        self.name = name
+        self._rf = None
+
+    def __enter__(self):
+        if _dflash_nvtx_enabled():
+            torch.cuda.nvtx.range_push(self.name)
+            self._rf = torch.profiler.record_function(self.name)
+            self._rf.__enter__()
+        return self
+
+    def __exit__(self, *exc):
+        if _dflash_nvtx_enabled():
+            if self._rf is not None:
+                self._rf.__exit__(*exc)
+                self._rf = None
+            torch.cuda.nvtx.range_pop()
+        return False
