+
+
+def _get_xqa_dedicated_stream() -> torch.cuda.Stream:
+    """Return the process-stable dedicated XQA decode stream.
+
+    Created lazily on first use, which must happen during eager warmup
+    (never while a CUDA graph capture is active). The exact same stream is
+    reused for all later captures and replays; there is no per-call stream
+    allocation. Raising here (instead of creating a stream mid-capture)
+    gives a clear error when ``VLLM_XQA_DEDICATED_STREAM=1`` is combined
+    with capture before any eager XQA decode.
+    """
+    global _xqa_dedicated_stream
+    if _xqa_dedicated_stream is None:
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError(
+                "VLLM_XQA_DEDICATED_STREAM=1 requires the dedicated XQA "
+                "stream to be created during eager warmup, but the first "
+                "XQA decode call happened while a CUDA graph capture was "
+                "active. Ensure an eager warmup decode precedes capture, or "
+                "disable the flag."
+            )
+        _xqa_dedicated_stream = torch.cuda.Stream(device="cuda")
+    return _xqa_dedicated_stream
+
+
+_xqa_dedicated_stream_logged = False
+
+
+def _log_xqa_dedicated_stream_once(stream: torch.cuda.Stream) -> None:
+    """One-time log (under VLLM_XQA_LOG_WORKSPACE) of the dedicated stream."""
+    global _xqa_dedicated_stream_logged
+    if _xqa_dedicated_stream_logged:
+        return
+    _xqa_dedicated_stream_logged = True
+    try:
+        capturing = torch.cuda.is_current_stream_capturing()
+    except Exception:
+        capturing = "unavailable"
+    logger.info(
+        "XQA dedicated stream: enabled=1 stream=%s cuda_stream=%s capturing=%s",
+        stream,
+        getattr(stream, "cuda_stream", None),
+        capturing,
+    )
+
+
+@contextmanager
+def _xqa_decode_stream_scope(decode_with_xqa: bool = False) -> Iterator[None]:
+    """Run the XQA decode kernel on a dedicated CUDA stream when enabled.
+
+    Disabled (null behavior, direct call preserved exactly) unless
+    ``VLLM_XQA_DEDICATED_STREAM`` is exactly ``"1"`` and ``decode_with_xqa``
+    is true. When enabled, the body executes on the process-stable dedicated
+    stream with CUDA-graph-correct fork/join topology:
+
+    * the dedicated stream first waits on the current stream (fork),
+    * the body runs under ``torch.cuda.stream(xqa_stream)``,
+    * the current stream then waits on the dedicated stream (join).
+
+    The wait edges are captured into the graph when the body runs during a
+    CUDA graph capture, so replays preserve the side-stream topology.
+    """
+    if os.getenv("VLLM_XQA_DEDICATED_STREAM", "") != "1" or not decode_with_xqa:
+        yield
+        return
+    stream = _get_xqa_dedicated_stream()
+    if os.getenv("VLLM_XQA_LOG_WORKSPACE", "0") == "1":
+        _log_xqa_dedicated_stream_once(stream)
+    current = torch.cuda.current_stream()
+    stream.wait_stream(current)
+    try:
+        with torch.cuda.stream(stream):
+            yield
+    finally:
+        current.wait_stream(stream)
