+    ) -> None:
+        layer_id = id(layer)
+        if layer_id in self._logged_layer_ids:
+            return
+        self._logged_layer_ids.add(layer_id)
+        try:
+            stream = torch.cuda.current_stream()
+            capturing = torch.cuda.is_current_stream_capturing()
+            stream_desc = str(stream)
+            capture_desc = str(capturing)
+        except Exception:
+            stream_desc = "unavailable"
+            capture_desc = "unavailable"
