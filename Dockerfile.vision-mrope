# syntax=docker/dockerfile:1.7
# Minimal .3 candidate layer over the published .2 runtime.
# No CUDA/native rebuild: the two Python files extend the Triton JIT kernel;
# the new M-RoPE variants compile on first use and persist in vllm-cache.
ARG BASE_IMAGE=ghcr.io/seanyourhighness/vllm-sm12x-nvfp4-dflash2@sha256:06f0c21d05bba880fa3133d5f191aa7e12210c2b8012f201314a0b7350e07c1c
FROM ${BASE_IMAGE}

RUN --mount=type=bind,source=0002-qwen3-next-fused-mrope-vision.patch,target=/tmp/0002.patch,readonly \
    set -eu; \
    awk '/^diff --git / { keep = ($3 ~ /^a\/vllm\//) } keep { print }' \
      /tmp/0002.patch > /tmp/0002-production.patch; \
    patch --batch --forward --directory=/usr/local/lib/python3.12/dist-packages \
      --strip=1 < /tmp/0002-production.patch; \
    rm -f /tmp/0002-production.patch

ENV TRITON_CACHE_DIR=/home/vllm/.cache/vllm/triton
LABEL org.opencontainers.image.version="v0.27.1-sm12x-dflash2.3" \
      io.github.seanyourhighness.vllm.base-image="v0.27.1-sm12x-dflash2.2" \
      io.github.seanyourhighness.vllm.vision-mrope-layer="two Python files; 12,600 bytes" \
      io.github.seanyourhighness.vllm.vision-mrope-upstream="vllm-project/vllm#49744, #43056"
